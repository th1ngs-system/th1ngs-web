          <pre><span class="hk">name</span>: <span class="hs">Simple Task Workflow</span>
<span class="hk">initial_state</span>: <span class="hs">open</span>
<span class="hk">states</span>:
  - <span class="hk">id</span>: <span class="hs">open</span>
    <span class="hk">label</span>: <span class="hs">Open</span>
    <span class="hk">color</span>: <span class="hs">"#6366f1"</span>
  - <span class="hk">id</span>: <span class="hs">in_progress</span>
    <span class="hk">label</span>: <span class="hs">In Progress</span>
    <span class="hk">color</span>: <span class="hs">"#f59e0b"</span>
  - <span class="hk">id</span>: <span class="hs">done</span>
    <span class="hk">label</span>: <span class="hs">Done</span>
    <span class="hk">color</span>: <span class="hs">"#22c55e"</span>
<span class="hk">transitions</span>:
  - <span class="hk">from</span>: <span class="hs">open</span>
    <span class="hk">to</span>:   <span class="hs">in_progress</span>
    <span class="hk">label</span>: <span class="hs">Start Work</span>
  - <span class="hk">from</span>: <span class="hs">in_progress</span>
    <span class="hk">to</span>:   <span class="hs">done</span>
    <span class="hk">label</span>: <span class="hs">Mark Complete</span></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INFRASTRUCTURE AS CODE ── -->
  <section class="split-section">
    <div class="section-inner split-inner" style="flex-direction: row-reverse;">
      <div class="split-text">
        <span class="section-label">Infrastructure as Code</span>
        <h2 class="split-title">Configuration lives in files, not clicks</h2>
        <p class="split-desc">Th1ngs is built around an Infrastructure-as-Code model. Every Box, workflow, and field definition is stored in files you can version — forget manual changes between environments.</p>
        <ul class="split-list">
          <li><i class="bi bi-check2-circle"></i> Boxes, workflows and fields defined as versionable config</li>
          <li><i class="bi bi-check2-circle"></i> Promote the same file across environments, never repeat a click</li>
          <li><i class="bi bi-check2-circle"></i> Full history and review for every configuration change</li>
        </ul>
      </div>
      <div class="split-visual">
        <div class="code-block">
          <div class="code-header">
            <span class="code-dot red"></span>
            <span class="code-dot yellow"></span>
            <span class="code-dot green"></span>
            <span class="code-filename">box.yaml</span>
          </div>
          <pre><span class="hk">name</span>: <span class="hs">Support Tickets</span>
<span class="hk">key</span>: <span class="hs">SUP</span>
<span class="hk">type</span>: <span class="hs">service-management</span>
<span class="hk">security</span>:
  <span class="hk">visibility</span>: <span class="hs">private</span>
  <span class="hk">roles</span>:
    - <span class="hk">role</span>: <span class="hs">admin</span>
      <span class="hk">users</span>: [<span class="hs">alice</span>]
    - <span class="hk">role</span>: <span class="hs">editor</span>
      <span class="hk">users</span>: [<span class="hs">support-team</span>]
<span class="hk">features</span>:
  <span class="hk">attachments</span>: <span class="hs">true</span>
  <span class="hk">comments</span>: <span class="hs">true</span></pre>
        </div>
      </div>
    </div>
  </section>

